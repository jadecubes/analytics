{
  "npm.packageManager": "pnpm",
  "editor.codeActionsOnSave": {
    "source.fixAll.eslint": "explicit"
  },
  "typescript.preferences.importModuleSpecifier": "project-relative",
  "files.exclude": {
    "node_modules": true,
    "dist": true
  },
  "files.watcherExclude": {
    "node_modules": true,
    "dist": true
  }
}
